# Relative /api uses Vite proxy → works on localhost, LAN IP and port-forward
VITE_API_URL=/api
# Public product name shown in the UI (header, landing, document title, …).
# Defaults to Dalposto when unset (see src/config/brand.ts).
VITE_APP_NAME=Dalposto
VITE_REVERB_APP_KEY=your-reverb-app-key
# WebSocket goes through Vite proxy (/app → Reverb). Set false to connect directly to Reverb.
VITE_REVERB_USE_PROXY=true
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_DEMO_TENANT=azure-beach
VITE_DEMO_LOCATION=umbrella12
