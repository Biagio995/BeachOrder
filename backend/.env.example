APP_NAME=Servio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
# DevTunnel / demo pubblico: imposta entrambi all'URL https://xxxx-5173.euw.devtunnels.ms
# PUBLIC_URL=https://xxxx-5173.euw.devtunnels.ms

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production: route logs to JSON + stderr (Docker/K8s) or add papertrail
# LOG_CHANNEL=centralized
# LOG_CENTRALIZED_STACK=json,stderr
# LOG_STACK=single,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Centralized log shipping (optional — Papertrail / Logtail / CloudWatch agent)
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# US-09 Monitoring
MONITORING_FRONTEND_CHECK=true
MONITORING_FRONTEND_TIMEOUT=3
MONITORING_QUEUE_HEARTBEAT_MAX_AGE=120
MONITORING_FAILED_JOBS_THRESHOLD=5
MONITORING_WEBHOOK_STALE_AFTER=86400
MONITORING_BACKUP_STALE_AFTER=90000
MONITORING_METRICS_WINDOW=300
MONITORING_ERROR_RATE_THRESHOLD=0.05
MONITORING_RESPONSE_TIME_ALERT_MS=3000
MONITORING_ALERT_SLACK_WEBHOOK=
MONITORING_ALERT_COOLDOWN=300
# LOG_SLACK_WEBHOOK_URL=

# Local default: SQLite. Switch to pgsql when docker compose is up.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=servio
# DB_USERNAME=servio
# DB_PASSWORD=servio

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Use "s3" when MinIO/docker is available
FILESYSTEM_UPLOADS_DISK=public
SANCTUM_TOKEN_EXPIRATION=10080
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local inbox: docker compose up -d mailpit → http://127.0.0.1:8025
# Recupero password + verifica email nuovo tenant finiscono lì.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="info@seatqui.com"
MAIL_FROM_NAME="${APP_NAME}"
# Privacy / contact (used by legal pages & data-subject flows)
# PRIVACY_CONTROLLER_EMAIL=info@seatqui.com
# PRIVACY_PROCESSOR_EMAIL=info@seatqui.com
# Senza Docker: MAIL_MAILER=log  (contenuto in storage/logs/laravel.log)
#
# Produzione Dynadot (Pro + Remote Access ON nella webmail):
# MAIL_MAILER=smtp
# MAIL_HOST=webhost.dynadot.com
# MAIL_PORT=587
# MAIL_USERNAME=info@seatqui.com
# MAIL_PASSWORD=your-mailbox-password
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS="info@seatqui.com"

# OTP (password reset / email verification / mail:test-otp)
# OTP_LENGTH=6
# OTP_TTL=900
# OTP_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=servio
AWS_SECRET_ACCESS_KEY=servio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=servio
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Database backups (US-08)
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DISK=backups
BACKUP_REMOTE_DISK=s3
BACKUP_REMOTE_PATH=database
BACKUP_ENCRYPT=true
# BACKUP_ALERT_EMAIL=ops@servio.test
# BACKUP_ALERT_SLACK_WEBHOOK=

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=269467
REVERB_APP_KEY=pcrxnxletfeemtelvhyn
REVERB_APP_SECRET=5yetqbxazp8fdaburzdi
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Platform owner (super admin) — set these before `php artisan db:seed`
SUPER_ADMIN_EMAIL=super@servio.test
SUPER_ADMIN_PASSWORD=password
SUPER_ADMIN_NAME="Platform Super Admin"

# Stripe (platform subscription + customer order payments)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL_ID=
SUBSCRIPTION_ANNUAL_PRICE_CENTS=29900
SUBSCRIPTION_VAT_NOTE="+ VAT"
# Days before suspending a tenant after a failed subscription payment (US-06)
BILLING_GRACE_PERIOD_DAYS=7

# Auto-translate product/category/tag names when a UI locale is missing in DB
# Catalog auto-translation (product/category names). DB stores only el+en; it/de are translated at runtime.
TRANSLATION_AUTO=true
TRANSLATION_DRIVER=mymemory
# TRANSLATION_MYMEMORY_EMAIL=you@example.com
# TRANSLATION_CACHE_TTL=2592000

# Public demo (video campaign) — see docs/DEMO.md
# DEMO_MODE=true
# DEMO_SEED=true
# DEMO_TENANT_SLUG=lido-azzurra
# DEMO_PUBLIC_URL=https://your-demo-url.example
# DEMO_QR_OUTPUT=storage/app/demo-qr
# DEMO_QR_SIZE=640
# DEMO_QR_MARGIN=16
# DEMO_ADMIN_EMAIL=admin@lido-azzurra.demo
# DEMO_STAFF_EMAIL=cucina@lido-azzurra.demo
# DEMO_BAR_EMAIL=bar@lido-azzurra.demo
# DEMO_WAITER_EMAIL=sala@lido-azzurra.demo
# Demo staff passwords: read from env, 'password' default applies to local dev only.
# DEMO_ADMIN_PASSWORD=change-me
# DEMO_STAFF_PASSWORD=change-me
# DEMO_BAR_PASSWORD=change-me
# DEMO_WAITER_PASSWORD=change-me
# DEMO_QUEUE_WORKER=true
# Hardware stays off in demo unless explicitly enabled:
# DEMO_PRINTERS_ENABLED=false
# DEMO_POS_ENABLED=false
