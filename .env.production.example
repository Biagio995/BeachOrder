# Example production env for docker-compose.prod.yml
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production

APP_NAME=Ordequi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
PUBLIC_URL=https://your-domain.example

APP_LOCALE=it
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=servio
DB_USERNAME=servio
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_UPLOADS_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-domain.example

REVERB_APP_ID=269467
REVERB_APP_KEY=pcrxnxletfeemtelvhyn
REVERB_APP_SECRET=5yetqbxazp8fdaburzdi
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SUPER_ADMIN_EMAIL=admin@your-domain.example
SUPER_ADMIN_PASSWORD=change-me-strong
SUPER_ADMIN_NAME="Platform Super Admin"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL_ID=

RUN_MIGRATIONS=true
RUN_SEEDERS=false
