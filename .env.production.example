# Example production env for docker-compose.prod.yml
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production

APP_NAME=Dalposto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
PUBLIC_URL=https://your-domain.example

APP_LOCALE=it
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=servio
DB_USERNAME=servio
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_UPLOADS_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dynadot Email (Pro + Remote Access enabled in webmail settings)
# Docs: https://www.dynadot.com/help/question/POP3-SMTP-settings
MAIL_MAILER=smtp
MAIL_HOST=webhost.dynadot.com
MAIL_PORT=587
MAIL_USERNAME=info@seatqui.com
MAIL_PASSWORD=change-me
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="info@seatqui.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contact / privacy (legal pages & data-subject requests)
PRIVACY_CONTROLLER_EMAIL=info@seatqui.com
PRIVACY_PROCESSOR_EMAIL=info@seatqui.com

SANCTUM_STATEFUL_DOMAINS=your-domain.example

REVERB_APP_ID=269467
REVERB_APP_KEY=pcrxnxletfeemtelvhyn
REVERB_APP_SECRET=5yetqbxazp8fdaburzdi
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SUPER_ADMIN_EMAIL=admin@your-domain.example
SUPER_ADMIN_PASSWORD=change-me-strong
SUPER_ADMIN_NAME="Platform Super Admin"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL_ID=

RUN_MIGRATIONS=true
RUN_SEEDERS=false

# Single-container runtime: nginx listens on $PORT (default 10000 for Render Free).
# docker-compose.prod.yml sets PORT=80; hosts like Render/Fly inject their own.
# PORT=10000

# Public demo (video campaign) — prefer docker-compose.demo.yml + .env.demo.example.
# See docs/DEMO.md
# DEMO_MODE=false
# DEMO_SEED=false
# DEMO_TENANT_SLUG=lido-azzurra
# DEMO_PUBLIC_URL=https://your-demo-url.example
# DEMO_QUEUE_WORKER=true
# DEMO_ADMIN_PASSWORD=change-me-strong-1
# DEMO_STAFF_PASSWORD=change-me-strong-2
# DEMO_BAR_PASSWORD=change-me-strong-3
# DEMO_WAITER_PASSWORD=change-me-strong-4
# DEMO_PRINTERS_ENABLED=false
# DEMO_POS_ENABLED=false
