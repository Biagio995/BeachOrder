# Example env for the single-container public demo (Render Free friendly).
# Copy to .env.demo and fill in the secrets:
#   cp .env.demo.example .env.demo
#
# NEVER commit .env.demo with real secrets.
# Product display name comes from APP_NAME / VITE_APP_NAME at deploy time
# (do not hardcode a brand here). Neutral fictional domains only.

APP_NAME=Demo
APP_KEY=
APP_DEBUG=false
# Render: all three must be the public HTTPS URL (no trailing slash).
APP_URL=https://your-demo-url.example
FRONTEND_URL=https://your-demo-url.example
PUBLIC_URL=https://your-demo-url.example
# Required so staff browsers accept the Sanctum session cookie on the demo host.
SANCTUM_STATEFUL_DOMAINS=your-demo-url.example

# Render Free injects $PORT; default 10000 matches this image.
PORT=10000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# SQLite on an ephemeral path (Render Free disk is ephemeral: every restart
# wipes the DB and DEMO_SEED recreates the same venue + QR codes).
DB_CONNECTION=sqlite
DB_DATABASE=/data/demo.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=demo
# DB_USERNAME=demo
# DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
# Use database + DEMO_QUEUE_WORKER=true (default), or sync + DEMO_QUEUE_WORKER=false
# to drop the queue process on a 512 MB host.
QUEUE_CONNECTION=database
DEMO_QUEUE_WORKER=true
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=269467
REVERB_APP_KEY=pcrxnxletfeemtelvhyn
REVERB_APP_SECRET=change-me-generate-a-random-string
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# IMPORTANT: the frontend is built with VITE_REVERB_APP_KEY (build arg);
# it must equal REVERB_APP_KEY — if you change the key, rebuild the image.
# Render: set it as a Docker build arg (see docs/DEMO.md).

# --- Demo mode (safe public demo, see docs/DEMO.md) ---
DEMO_MODE=true
DEMO_SEED=true
DEMO_TENANT_SLUG=lido-azzurra
# Base URL printed inside QR codes (defaults to PUBLIC_URL → FRONTEND_URL → APP_URL).
# DEMO_PUBLIC_URL=https://your-demo-url.example
# DEMO_QR_OUTPUT=storage/app/demo-qr

DEMO_ADMIN_EMAIL=admin@lido-azzurra.demo
DEMO_STAFF_EMAIL=cucina@lido-azzurra.demo
DEMO_BAR_EMAIL=bar@lido-azzurra.demo
DEMO_WAITER_EMAIL=sala@lido-azzurra.demo
# Passwords for the demo users — SET THESE, no production default exists.
DEMO_ADMIN_PASSWORD=change-me-strong-1
DEMO_STAFF_PASSWORD=change-me-strong-2
DEMO_BAR_PASSWORD=change-me-strong-3
DEMO_WAITER_PASSWORD=change-me-strong-4

# Platform super admin (created by DemoSeeder when DEMO_SEED=true).
SUPER_ADMIN_EMAIL=super@demo.example
SUPER_ADMIN_NAME="Platform Super Admin"
SUPER_ADMIN_PASSWORD=change-me-strong-0

# Hardware stays off in demo (never enable for the public URL).
DEMO_PRINTERS_ENABLED=false
DEMO_POS_ENABLED=false

# Safe demo: OTP emails go to the container log (read them with
# `docker logs` / Render log viewer), no backups, POS stubbed, no frontend probe.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=stderr
MAIL_FROM_ADDRESS="info@seatqui.com"
MAIL_FROM_NAME="${APP_NAME}"
# Produzione Dynadot SMTP (Pro + Remote Access):
# MAIL_HOST=webhost.dynadot.com
# MAIL_PORT=587
# MAIL_USERNAME=info@seatqui.com
# MAIL_PASSWORD=...
# MAIL_SCHEME=tls
BACKUP_ENABLED=false
POS_FORCE_STUB=true
MONITORING_FRONTEND_CHECK=false

# Online payments are OFF product-wide (customers order, then pay at the
# venue): no Stripe or payment env is needed for the demo.

RUN_MIGRATIONS=true
RUN_SEEDERS=false
