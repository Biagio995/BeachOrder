# Example env for the single-container public demo.
# Copy to .env.demo and fill in the secrets:
#   cp .env.demo.example .env.demo
#
# NEVER commit .env.demo with real secrets.

APP_NAME=Servio
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-demo-url.example
FRONTEND_URL=https://your-demo-url.example
PUBLIC_URL=https://your-demo-url.example

# Hosts like Koyeb/Render/Fly inject $PORT themselves; keep 8080 otherwise.
PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# SQLite on a volume (default in image); switch to pgsql by overriding DB_*.
DB_CONNECTION=sqlite
DB_DATABASE=/data/demo.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=servio
# DB_USERNAME=servio
# DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=269467
REVERB_APP_KEY=pcrxnxletfeemtelvhyn
REVERB_APP_SECRET=change-me-generate-a-random-string
REVERB_HOST=0.0.0.0
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# IMPORTANT: frontend is built with VITE_REVERB_APP_KEY; if you change
# REVERB_APP_KEY you must rebuild the image.

# --- Demo mode (safe public demo, see docs/DEMO.md) ---
DEMO_MODE=true
DEMO_SEED=true
DEMO_TENANT_SLUG=lido-azzurra
# Base URL printed inside QR codes (defaults to PUBLIC_URL → FRONTEND_URL → APP_URL).
# DEMO_PUBLIC_URL=https://your-demo-url.example
# DEMO_QR_OUTPUT=storage/app/demo-qr

# Curated Italian demo copy is served as-is (auto-translation forced off in demo).
TRANSLATION_AUTO=false

DEMO_ADMIN_EMAIL=admin@lido-azzurra.demo
DEMO_STAFF_EMAIL=cucina@lido-azzurra.demo
DEMO_WAITER_EMAIL=sala@lido-azzurra.demo
# Passwords for the demo users — SET THESE, no production default exists.
DEMO_ADMIN_PASSWORD=change-me-strong-1
DEMO_STAFF_PASSWORD=change-me-strong-2
DEMO_WAITER_PASSWORD=change-me-strong-3

# Hardware stays off in demo (never enable for the public URL).
DEMO_PRINTERS_ENABLED=false
DEMO_POS_ENABLED=false

# Online payments are OFF product-wide (customers order, then pay at the
# venue): no Stripe or payment env is needed for the demo.

RUN_MIGRATIONS=true
RUN_SEEDERS=false
